# Opcional (retrocompat): sobrepoe a URL do WebSocket. So defina se o WS ficar em
# host/porta diferente do HTTP; senao NAO precisa (deriva da VITE_EVA_API_URL).
# VITE_EVA_WS_URL=ws://localhost:8000
VITE_EVA_DEV_TOKEN=
